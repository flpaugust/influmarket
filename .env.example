# ═══════════════════════════════════════════════════════════════
# InfluMarket — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════
# Copie este arquivo para .env.local e preencha com seus valores.
# NUNCA commite o arquivo .env.local no controle de versão (Git).

# ── Firebase Client SDK (Público / Frontend) ──────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Firebase Admin SDK (Privado / Server-Side) ────────────────
# Credenciais do Service Account para gravações seguras via backend.
# Gere em: Firebase Console > Project Settings > Service Accounts > Generate New Private Key.
# ATENÇÃO: Estas chaves são SECRETAS e jamais devem ser expostas ao frontend.
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── NextAuth / App Secret ─────────────────────────────────────
NEXTAUTH_SECRET=your_auth_secret_key
NEXTAUTH_URL=http://localhost:3000

# ── Google Gemini API (Hub Conversacional) ─────────────────────
# Chave privada da API do Gemini. Gere em: Google AI Studio > API Keys.
# Nunca expor como NEXT_PUBLIC — esta chave opera apenas no server-side.
GEMINI_API_KEY=your_gemini_api_key
